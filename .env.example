# Optional additional hostnames/IPs for Vite's local development certificate.
# Copy this file to .env.local. Values are comma-separated, without schemes/ports.
HERO68_DEV_HOSTS=

# Optional exact origins for the Windows service, in addition to the built-in defaults.
# Set this in the service process environment; Vite's .env.local is not loaded by the service.
# Example: https://your-host:5173,http://localhost:4173
HERO68_ALLOWED_ORIGINS=
